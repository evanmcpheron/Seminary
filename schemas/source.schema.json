{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/source.schema.json",
  "title": "Verified Source Record",
  "type": "object",
  "required": [
    "source_id",
    "source_type",
    "title",
    "verification_status",
    "accessed_at",
    "access_category"
  ],
  "properties": {
    "source_id": {
      "type": "string"
    },
    "source_type": {
      "enum": [
        "scripture",
        "primary-text",
        "book",
        "article",
        "chapter",
        "reference-work",
        "video",
        "podcast",
        "website",
        "catalog"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "publisher": {
      "type": [
        "string",
        "null"
      ]
    },
    "year": {
      "type": [
        "integer",
        "string",
        "null"
      ]
    },
    "edition": {
      "type": [
        "string",
        "null"
      ]
    },
    "isbn": {
      "type": [
        "string",
        "null"
      ]
    },
    "doi": {
      "type": [
        "string",
        "null"
      ]
    },
    "url": {
      "type": [
        "string",
        "null"
      ]
    },
    "accessed_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "verification_status": {
      "enum": [
        "unverified",
        "partially-verified",
        "verified",
        "unavailable"
      ]
    },
    "access_category": {
      "enum": [
        "required-purchase",
        "required-free",
        "required-access",
        "recommended",
        "optional-reference",
        "not-applicable"
      ]
    },
    "free_access_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "required_cost_usd": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "access_note": {
      "type": [
        "string",
        "null"
      ]
    },
    "copyright_note": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "access_category": {
            "const": "required-free"
          }
        },
        "required": [
          "access_category"
        ]
      },
      "then": {
        "required": [
          "free_access_url",
          "required_cost_usd"
        ],
        "properties": {
          "verification_status": {
            "const": "verified"
          },
          "free_access_url": {
            "type": "string",
            "minLength": 1
          },
          "required_cost_usd": {
            "const": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "access_category": {
            "const": "required-access"
          }
        },
        "required": [
          "access_category"
        ]
      },
      "then": {
        "required": [
          "access_note"
        ],
        "properties": {
          "access_note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source_type": {
            "const": "scripture"
          }
        },
        "required": [
          "source_type"
        ]
      },
      "then": {
        "required": [
          "required_cost_usd"
        ],
        "properties": {
          "access_category": {
            "enum": [
              "required-free",
              "recommended",
              "optional-reference",
              "not-applicable"
            ]
          },
          "required_cost_usd": {
            "const": 0
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
