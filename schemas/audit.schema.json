{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/audit.schema.json",
  "title": "Seminary Quality Audit Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "audit_id",
    "audit_type",
    "scope",
    "verdict",
    "audited_on",
    "audit_run_id",
    "auditor_identity",
    "generation_run_ids",
    "independence",
    "report_path",
    "blocking_findings"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "audit_id": {
      "type": "string",
      "minLength": 1
    },
    "audit_type": {
      "enum": [
        "source-copyright",
        "theology-fairness",
        "course-coherence",
        "semester-workload",
        "longitudinal-progression"
      ]
    },
    "scope": {
      "type": "object",
      "properties": {
        "course_id": {
          "type": "string",
          "minLength": 1
        },
        "program_year": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "term": {
          "type": "string",
          "minLength": 1
        }
      },
      "anyOf": [
        {
          "required": [
            "course_id"
          ]
        },
        {
          "required": [
            "program_year"
          ]
        }
      ],
      "additionalProperties": true
    },
    "verdict": {
      "enum": [
        "pass",
        "pass-with-nonblocking-findings",
        "fail"
      ]
    },
    "audited_on": {
      "type": "string",
      "format": "date"
    },
    "audit_run_id": {
      "type": "string",
      "minLength": 1
    },
    "auditor_identity": {
      "type": "string",
      "minLength": 1
    },
    "generation_run_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "independence": {
      "type": "object",
      "required": [
        "separate_run",
        "clean_context"
      ],
      "properties": {
        "separate_run": {
          "const": true
        },
        "clean_context": {
          "const": true
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "report_path": {
      "type": "string",
      "minLength": 1
    },
    "content_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "depends_on_audits": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "blocking_findings": {
      "type": "array"
    },
    "nonblocking_findings": {
      "type": "array"
    },
    "benchmark_evidence": {
      "type": "array"
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "audit_type": {
            "enum": [
              "source-copyright",
              "theology-fairness",
              "course-coherence"
            ]
          }
        },
        "required": [
          "audit_type"
        ]
      },
      "then": {
        "required": [
          "content_fingerprint"
        ]
      }
    }
  ]
}
