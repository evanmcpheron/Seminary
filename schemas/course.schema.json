{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/course.schema.json",
  "title": "Seminary Course Metadata",
  "type": "object",
  "required": [
    "schema_version",
    "course_id",
    "course_code",
    "course_title",
    "catalog_source_institution",
    "catalog_year",
    "catalog_url",
    "independent_curriculum_notice",
    "academic_stage",
    "program_year",
    "term",
    "credit_hours",
    "instructional_weeks",
    "estimated_total_hours",
    "course_description",
    "status"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "course_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "course_code": {
      "type": "string",
      "minLength": 1
    },
    "course_title": {
      "type": "string",
      "minLength": 1
    },
    "catalog_source_institution": {
      "type": "string",
      "minLength": 1
    },
    "catalog_year": {
      "type": "string",
      "minLength": 1
    },
    "catalog_url": {
      "type": "string",
      "minLength": 1
    },
    "independent_curriculum_notice": {
      "const": true
    },
    "academic_stage": {
      "enum": [
        "undergraduate",
        "mdiv",
        "phd"
      ]
    },
    "program_year": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "term": {
      "type": "string",
      "minLength": 1
    },
    "credit_hours": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "instructional_weeks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "estimated_total_hours": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "corequisites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "course_description": {
      "type": "string",
      "minLength": 1
    },
    "learning_outcomes": {
      "type": "array"
    },
    "required_texts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "designation"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "designation": {
            "enum": [
              "required-purchase",
              "required-free",
              "required-access"
            ]
          },
          "use_extent": {
            "enum": [
              "whole-work",
              "substantial-portion",
              "multiple-selections",
              "recurring-reference",
              "isolated-excerpt"
            ]
          },
          "instructional_weeks": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            }
          },
          "purchase_justification": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "designation": {
                  "const": "required-purchase"
                }
              },
              "required": [
                "designation"
              ]
            },
            "then": {
              "required": [
                "use_extent",
                "instructional_weeks",
                "purchase_justification"
              ],
              "properties": {
                "use_extent": {
                  "not": {
                    "const": "isolated-excerpt"
                  }
                }
              }
            }
          }
        ],
        "additionalProperties": true
      }
    },
    "recommended_texts": {
      "type": "array"
    },
    "assessment_breakdown": {
      "type": "array"
    },
    "known_unresolved_questions": {
      "type": "array"
    },
    "status": {
      "enum": [
        "shell",
        "researching",
        "designed",
        "in-production",
        "ready-for-audit",
        "released"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "designed",
              "in-production",
              "ready-for-audit",
              "released"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "required_texts"
        ]
      }
    }
  ],
  "additionalProperties": true
}
